<?xml version="1.0" encoding="utf-8"?><!--
   Сканы документов (база истории и изображения) содержат личные данные и не должны
   уходить в облако: исключаем их из cloud-backup и device-transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="file" path="scans" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="file" path="scans" />
    </device-transfer>
</data-extraction-rules>
